# Ech Lern production backend (owner/developer only)
# Normal learners never create Supabase. They just sign up in the app.
# Put these in Netlify/Vercel environment variables for deployment.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_ENABLE_SUPABASE=true

# Never expose service_role, JWT secret, DATABASE_URL, or private keys in Vite/frontend env vars.

# Optional Spotify learning integration.
# Public client id from Spotify Developer Dashboard. Never add a client secret to frontend env.
VITE_SPOTIFY_CLIENT_ID=

# Optional community Discord override. Must be an INVITE link, not a channel
# deep link: https://discord.gg/<invite-code> (Server Settings > Invites).
# A https://discord.com/channels/... URL is member-only and 404s for newcomers,
# so it is rejected and the shipped invite in src/data/communityLinks.ts is used.
VITE_ECHLERN_DISCORD_URL=
VITE_ECHLERN_FACEBOOK_URL=
